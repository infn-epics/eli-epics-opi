  <widget type="embedded" version="2.0.0">
    <name>Embedded Display_1</name>
    <file>m9210_ChannelView.bob</file>
    <x>306</x>
    <y>48</y>
    <width>819</width>
    <height>920</height>
    <scripts>
      <script file="EmbeddedPy">
        <text><![CDATA[from org.csstudio.display.builder.runtime.script import PVUtil
import math

try:
    # 1. Fetch the wrapped VType Object from the waveform array PV
    vtype_array = pvs[0].getValue()
    
    if vtype_array is not None:
        # Access the underlying raw Java array structure safely
        raw_data = vtype_array.getData()
        total_samples = raw_data.size()
        
        # Ensure we have a valid, populated trace array
        if total_samples > 30:
            
            # 2. Gather the first 25 samples to establish a live baseline average
            baseline_sum = 0.0
            for i in range(25):
                baseline_sum += raw_data.get(i)
            baseline_avg = baseline_sum / 25.0
            
            # Compute Standard Deviation (Noise Floor) for ultra-precise thresholds
            variance_sum = 0.0
            for i in range(25):
                variance_sum += (raw_data.get(i) - baseline_avg) ** 2
            std_deviation = math.sqrt(variance_sum / 25.0)
            
            # Trigger threshold is 4 standard deviations below background noise average
            threshold = baseline_avg - (4.0 * std_deviation)
            
            start_index = -1
            stop_index = -1
            
            # 3. Locate the falling edge (Start Bound)
            for i in range(total_samples):
                if raw_data.get(i) < threshold:
                    start_index = i
                    break
            
            # 4. Locate the recovery point back to baseline (Stop Bound)
            if start_index != -1:
                for i in range(start_index, total_samples):
                    if raw_data.get(i) >= baseline_avg:
                        # Verify stabilization by analyzing a lookahead buffer
                        if i + 4 < total_samples:
                            lookahead_sum = 0.0
                            for k in range(i, i + 4):
                                lookahead_sum += raw_data.get(k)
                            if (lookahead_sum / 4.0) >= threshold:
                                stop_index = i
                                break

            # Get structural handles for the screen components
            model = widget.getDisplayModel()
            start_line = model.getWidgetByName("Integral_Start_Line")
            end_line = model.getWidgetByName("Integral_End_Line")

  # 5. Execute Mathematical Trapezoidal Integration
            if start_index != -1 and stop_index != -1 and stop_index > start_index:
                integral_area = 0.0
                for j in range(start_index, stop_index - 1):
                    y1 = baseline_avg - raw_data.get(j)
                    y2 = baseline_avg - raw_data.get(j + 1)
                    integral_area += (y1 + y2) / 2.0
                
                # dt = 2.5e-10 seconds
                volt_seconds = integral_area * 2.5e-10
                result_str = "{:.3E} V*s".format(volt_seconds)
     
                # --- CALCULATE EXACT PIXEL POSITIONS FOR LINES ---
                # Fetch spatial geometry definitions of your live graph plot
                plot_x = int(widget.getPropertyValue("x"))
                plot_width = int(widget.getPropertyValue("width"))
                
                # Determine how many physical screen pixels represent a single sample index
                pixels_per_sample = float(plot_width) / float(total_samples)
                
                # Move and display the Start Boundary Line
                if start_line is not None:
                    target_start_x = int(plot_x + (start_index * pixels_per_sample))
                    start_line.setPropertyValue("x", target_start_x)
                    start_line.setPropertyValue("visible", True)
                    
                # Move and display the End Boundary Line
                if end_line is not None:
                    target_end_x = int(plot_x + (stop_index * pixels_per_sample))
                    end_line.setPropertyValue("x", target_end_x)
                    end_line.setPropertyValue("visible", True)
            else:
                result_str = "No Pulse Detected"
                # Hide lines safely if no waveform falling dip is currently occurring
                if start_line is not None: start_line.setPropertyValue("visible", False)
                if end_line is not None: end_line.setPropertyValue("visible", False)
                
            # 6. Flush final integration data string to your text box
            display_box = model.getWidgetByName("Integral_Display")
            if display_box is not None:
                display_box.setPropertyValue("text", result_str)
                
except Exception as e:
    print("VDoubleArray Geometry Integration Error: " + str(e))]]></text>
        <pv_name trigger="false">$(DEVICE):AI1:AVG</pv_name>
      </script>
    </scripts>
  </widget>
