  <widget type="action_button" version="3.0.0">
    <name>Calculate Integral</name>
    <actions execute_as_one="true">
    </actions>
    <text>Calculate Integral Ch1</text>
    <x>445</x>
    <y>8</y>
    <width>122</width>
    <font>
      <font name="Default Bold" family="Liberation Sans" style="BOLD" size="14.0">
      </font>
    </font>
    <scripts>
      <script file="EmbeddedPy" check_connections="false">
        <text><![CDATA[from org.csstudio.display.builder.runtime.script import ScriptUtil
from org.csstudio.display.builder.runtime.script import PVUtil
from org.csstudio.display.builder.runtime.pv import PVFactory
import math
import time

def safe_index(val, default, max_val):
    if val is None or math.isnan(val) or math.isinf(val):
        return default
    return max(0, min(int(round(val)), max_val))

def find_textbox_by_name_locally(container, target_name):
    if container is None:
        return None
    if hasattr(container, "isPresent") and container.isPresent():
        container = container.get()
    if container is None:
        return None
    if hasattr(container, "getName") and container.getName() == target_name:
        return container
    if hasattr(container, "getChildren"):
        for child in container.getChildren():
            found = find_textbox_by_name_locally(child, target_name)
            if found:
                return found
    return None

def execute_calculation():
    ICT_SENSITIVITY = 5.0     
    ATTENUATION_FACTOR = 1.0  
    CHANNEL = "1"

    try:
        print("--- Execution Engine: Manual Button Click on Channel [" + CHANNEL + "] ---")

        try:
            msg_pv = PVFactory.getPV("LEL:DIA:FCT01:MSGS")
            msg_pv.write("OFF")
            time.sleep(0.2)
            msg_pv.write("ON")
            PVFactory.releasePV(msg_pv)
        except Exception:
            pass

        parent_optional = widget.getParent()
        if parent_optional is None:
            return
        local_container = parent_optional.get() if hasattr(parent_optional, "isPresent") and parent_optional.isPresent() else parent_optional

        display_box = find_textbox_by_name_locally(local_container, "Integral_Display_Target")
        if display_box is None:
            return

        target_pv_name = "LEL:DIA:FCT01:AI" + CHANNEL + ":AVG"
        hardware_pv = PVFactory.getPV(target_pv_name)
        pv_reading = hardware_pv.read()
        raw_data = pv_reading.getData() if pv_reading is not None else None
        total_samples = raw_data.size() if raw_data is not None else 0

        if total_samples > 40 and raw_data is not None:
            dt = 2.5e-10 if total_samples > 1500 else 5.0e-10
            baseline_window = 30 if total_samples > 1500 else 15
            
            baseline_sum = 0.0
            for i in range(baseline_window):
                baseline_sum += raw_data.getDouble(i)
            baseline_avg = baseline_sum / float(baseline_window)
            
            m1_pv = PVFactory.getPV("loc://m1_" + CHANNEL + "(600)")
            m2_pv = PVFactory.getPV("loc://m2_" + CHANNEL + "(1200)")
            marker1_raw = PVUtil.getDouble(m1_pv)  
            marker2_raw = PVUtil.getDouble(m2_pv)  
            PVFactory.releasePV(m1_pv)
            PVFactory.releasePV(m2_pv)

            start_index = safe_index(marker1_raw, 600, total_samples - 2)
            stop_index = safe_index(marker2_raw, 1200, total_samples - 1)
            
            if start_index > stop_index:
                start_index, stop_index = stop_index, start_index
            
            if stop_index > start_index:
                integral_area = 0.0
                for j in range(start_index, stop_index - 1):
                    y1 = baseline_avg - raw_data.getDouble(j)
                    y2 = baseline_avg - raw_data.getDouble(j + 1)
                    integral_area += (y1 + y2) / 2.0
                
                volt_seconds = integral_area * dt
                corrected_volt_seconds = volt_seconds * ATTENUATION_FACTOR
                picocoulombs = (corrected_volt_seconds / ICT_SENSITIVITY) * 1e12
                
                result_str = "{:.2f} pC".format(picocoulombs)
                display_box.setPropertyValue("text", result_str)
                print("Manual Calculation Complete: " + result_str)
        else:
            display_box.setPropertyValue("text", "Disconnected")
                
        PVFactory.releasePV(hardware_pv)
    except Exception as e:
        print("Button execution fault: " + str(e))

execute_calculation()]]></text>
        <pv_name trigger="false">loc://m1_1(600)</pv_name>
        <pv_name trigger="false">loc://m2_1(1200)</pv_name>
      </script>
    </scripts>
    <tooltip>$(actions)</tooltip>
  </widget>
  <widget type="xyplot" version="3.0.0">
    <name>X/Y Plot_1</name>
    <x>22</x>
    <y>483</y>
    <width>729</width>
    <height>389</height>
    <scripts>
      <script file="EmbeddedPy">
        <text><![CDATA[from org.csstudio.display.builder.runtime.script import PVUtil
import math

ICT_SENSITIVITY = 5.0     
ATTENUATION_FACTOR = 1.0  
CHANNEL = "1"

try:
    pv_reading = pvs[0].read()
    
    if pv_reading is not None:
        raw_data = pv_reading.getData()
        total_samples = raw_data.size()
        
        if total_samples > 40:
            dt = 2.5e-10 if total_samples > 1500 else 5.0e-10
            baseline_window = 30 if total_samples > 1500 else 15
            
            baseline_sum = 0.0
            for i in range(baseline_window):
                baseline_sum += raw_data.getDouble(i)
            baseline_avg = baseline_sum / float(baseline_window)
            
            marker1_raw = PVUtil.getDouble(pvs[2])
            marker2_raw = PVUtil.getDouble(pvs[3])

            start_index = max(0, min(int(round(marker1_raw)), total_samples - 2))
            stop_index = max(0, min(int(round(marker2_raw)), total_samples - 1))
            
            if start_index > stop_index:
                start_index, stop_index = stop_index, start_index
            
            running_profile = [0.0] * total_samples
            cumulative_area = 0.0
            
            for j in range(0, total_samples - 1):
                if start_index <= j < stop_index:
                    y1 = raw_data.getDouble(j) - baseline_avg
                    y2 = raw_data.getDouble(j + 1) - baseline_avg
                    cumulative_area += (y1 + y2) / 2.0
                
                v_secs = cumulative_area * dt
                pC = (v_secs * ATTENUATION_FACTOR / ICT_SENSITIVITY) * 1e12
                running_profile[j+1] = float(pC)
            
            running_profile[0] = running_profile[1]
            pvs[4].write(running_profile)
                
except Exception as e:
    print("Marker Responsive Engine Error: " + str(e))]]></text>
        <pv_name>LEL:DIA:FCT01:AI1:AVG</pv_name>
        <pv_name trigger="false">loc://dummy_trigger_ch1(0)</pv_name>
        <pv_name>loc://m1_1</pv_name>
        <pv_name>loc://m2_1</pv_name>
        <pv_name trigger="false">loc://double_integral_array_ch1</pv_name>
      </script>
