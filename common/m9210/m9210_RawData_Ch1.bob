  <widget type="xyplot" version="3.0.0">
    <name>X/Y Plot_1</name>
    <x>22</x>
    <y>483</y>
    <width>729</width>
    <height>389</height>
    <scripts>
      <script file="EmbeddedPy" check_connections="false">
        <text><![CDATA[from org.csstudio.display.builder.runtime.script import PVUtil
import math
import jarray

try:
    # 1. FETCH LIVE SNAPSHOT WITH SAFE GUARD
    pv_reading = pvs[0].read()
    
    if pv_reading is not None:
        raw_data = pv_reading.getData()
        
        # Ensure the array actually contains data before proceeding
        if raw_data is not None and raw_data.size() > 40:
            total_samples = raw_data.size()
            
            # 2. READ NATIVE HARDWARE REGISTERS & FORCE SCALING COMPLIANCE
            cal_factor = PVUtil.getDouble(pvs[5]) 
            if cal_factor <= 1.0:
                cal_factor = 5.0
                
            attenuation_factor = PVUtil.getDouble(pvs[6])
            if attenuation_factor <= 0.0: 
                attenuation_factor = 1.0 
            
            # 3. CLOCK DT DERIVATION
            clk_val = PVUtil.getDouble(pvs[3])
            dt = 1.0 / (clk_val * 1e9) if clk_val < 100.0 else 1.0 / clk_val
            
            # 4. BASELINE NOISE FILTER
            baseline_window = 30 if total_samples > 1500 else 15
            baseline_sum = 0.0
            for i in range(baseline_window):
                baseline_sum += raw_data.getDouble(i)
            baseline_avg = baseline_sum / float(baseline_window)
            
            # 5. GATING COORDINATES
            marker1_raw = PVUtil.getDouble(pvs[1]) 
            width_raw = PVUtil.getDouble(pvs[2])   
            marker2_raw = marker1_raw + width_raw  

            start_index = max(0, min(int(round(marker1_raw)), total_samples - 2))
            stop_index = max(0, min(int(round(marker2_raw)), total_samples - 1))
            
            if start_index > stop_index:
                start_index, stop_index = stop_index, start_index
            
            # Allocate dedicated array size explicitly
            running_profile = [0.0] * total_samples
            cumulative_area = 0.0
            
            # 6. INTEGRAL TRAPEZOIDAL EXECUTION
            for j in range(0, total_samples - 1):
                if j < start_index:
                    running_profile[j+1] = 0.0
                elif start_index <= j < stop_index:
                    y1 = raw_data.getDouble(j) - baseline_avg
                    y2 = raw_data.getDouble(j + 1) - baseline_avg
                    cumulative_area += (y1 + y2) / 2.0
                    v_secs = cumulative_area * dt
                    running_profile[j+1] = float((v_secs * attenuation_factor / cal_factor) * 1e12)
                else:
                    running_profile[j+1] = running_profile[j]
            
            running_profile[0] = running_profile[1]
            
            # 7. SUCCESSFUL PUSH TO XY PLOT
            java_double_array = jarray.array(running_profile, 'd')
            pvs[4].write(java_double_array)
            
except Exception as e:
    # Keeps bad network frames from clearing out the screen graph visually
    print("Graph Network Frame Guarded -> Skipping Bad Array Element packet: " + str(e))]]></text>
        <pv_name>LEL:DIA:FCT01:AI1:AVG</pv_name>
        <pv_name>LEL:DIA:FCT01:MICB_OFFSET</pv_name>
        <pv_name>LEL:DIA:FCT01:UBUNCHSAMPL</pv_name>
