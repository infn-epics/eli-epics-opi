  <widget type="label" version="2.0.0">
    <name>Integral_Display_Target</name>
    <text>Channel 1 Integral Result:</text>
    <x>325</x>
    <y>10</y>
    <width>150</width>
    <font>
      <font name="Default Bold" family="Liberation Sans" style="BOLD" size="14.0">
      </font>
    </font>
    <scripts>
      <script file="EmbeddedPy" check_connections="false">
        <text><![CDATA[from org.csstudio.display.builder.runtime.script import PVUtil
import math

# Define calibration scaling constant locally to match layout 
ICT_SENSITIVITY = 5.0

try:
    # 1. Fetch live waveform data from the network
    raw_data = pvs[0].read().getData()
    total_samples = raw_data.size()
    
    # 2. Read live sampling rate clock
    sampling_freq_ghz = PVUtil.getDouble(pvs[3])
    dt = 1.0 / (sampling_freq_ghz * 1e9) if sampling_freq_ghz < 100.0 else 1.0 / sampling_freq_ghz
    
    # 3. Dynamic baseline calculation
    baseline_window = 30 if total_samples > 1500 else 15
    baseline_sum = 0.0
    for i in range(baseline_window):
        baseline_sum += raw_data.getDouble(i)
    baseline_avg = baseline_sum / float(baseline_window)
    
    # 4. Map boundaries straight to parameters
    start = int(round(PVUtil.getDouble(pvs[1])))  # MICB_OFFSET
    width = int(round(PVUtil.getDouble(pvs[2])))  # UBUNCHSAMPL
    stop = start + width
    
    # Array boundary protection guards
    start = max(0, min(start, total_samples - 2))
    stop = max(0, min(stop, total_samples - 1))
    
    if start > stop:
        start, stop = stop, start
        
    # FETCH HARDWARE ATTENUATOR
    attenuation_factor = PVUtil.getDouble(pvs[6])
    if attenuation_factor <= 0.0:
        attenuation_factor = 1.0
    
    # 5. Clean, Scalar Trapezoidal Integration loop
    integral_area = 0.0
    for j in range(start, stop):
        y1 = raw_data.getDouble(j) - baseline_avg
        y2 = raw_data.getDouble(j + 1) - baseline_avg
        integral_area += (y1 + y2) / 2.0
    
    # 6. Calculate ultimate charge using live attenuator and sensitivity divisor
    v_secs = integral_area * dt
    pC = (v_secs * attenuation_factor / ICT_SENSITIVITY) * 1e12
    
    # Update the UI text label (uses abs to display clean positive text value)
    widget.setPropertyValue("text", "{:.2f} pC".format(abs(pC)))
    
except Exception as e:
    print("Label Script Error: " + str(e))]]></text>
        <pv_name trigger="false">LEL:DIA:FCT01:AI1:AVG</pv_name>
        <pv_name>LEL:DIA:FCT01:MICB_OFFSET</pv_name>
        <pv_name>LEL:DIA:FCT01:UBUNCHSAMPL</pv_name>
        <pv_name trigger="false">LEL:DIA:FCT01:CLKF_SP</pv_name>
        <pv_name trigger="false">loc://microbunch_integral_array</pv_name>
        <pv_name trigger="false">LEL:DIA:FCT01:K_CAL</pv_name>
        <pv_name trigger="false">LEL:DIA:FCT01:AI1:ATT_RB</pv_name>
      </script>
    </scripts>
