    </actions>
    <rules>
      <rule name="enablech1" prop_id="traces[0].visible" out_exp="false">
        <exp bool_exp="pv0==1">
          <value>true</value>
        </exp>
        <exp bool_exp="pv0==0">
          <value>false</value>
        </exp>
        <pv_name>loc://enable_ch1_$(DID)(1)</pv_name>
      </rule>
    </rules>
    <x_axis>
      <title>Samples [n] to Time [ns]</title>
      <autoscale>true</autoscale>
