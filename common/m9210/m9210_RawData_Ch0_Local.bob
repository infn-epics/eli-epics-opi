        <font name="IO Normal" family="sans" style="REGULAR" size="10.891089108910892">
        </font>
      </title_font>
      <scale_font>
        <font name="IO Scale 1" family="sans" style="REGULAR" size="10.891089108910892">
        </font>
      </scale_font>
      <visible>true</visible>
    </x_axis>
    <y_axes>
