  <widget type="xyplot" version="3.0.0">
    <name>XY Graph Template</name>
    <x>23</x>
    <y>55</y>
    <width>728</width>
    <height>439</height>
    <foreground_color>
      <color name="IO Foreground" red="0" green="0" blue="0">
      </color>
    </foreground_color>
    <background_color>
      <color name="IO InputPV Bg" red="255" green="255" blue="255">
      </color>
    </background_color>
    <title>Raw Data - Channel 0 Local PV</title>
    <title_font>
      <font name="IO Title" family="sans" style="BOLD" size="13.861386138613861">
      </font>
    </title_font>
    <show_toolbar>true</show_toolbar>
    <actions>
    </actions>
    <rules>
      <rule name="enablech1" prop_id="traces[0].visible" out_exp="false">
        <exp bool_exp="pv0==1">
          <value>true</value>
        </exp>
        <exp bool_exp="pv0==0">
          <value>false</value>
        </exp>
        <pv_name>loc://enable_ch1_$(DID)(1)</pv_name>
      </rule>
    </rules>
    <x_axis>
      <title>Samples [n] to Time [ns]</title>
      <autoscale>true</autoscale>
      <log_scale>false</log_scale>
      <minimum>0.0</minimum>
      <maximum>2059.0</maximum>
      <show_grid>true</show_grid>
      <title_font>
        <font name="IO Normal" family="sans" style="REGULAR" size="10.891089108910892">
        </font>
      </title_font>
      <scale_font>
        <font name="IO Scale 1" family="sans" style="REGULAR" size="10.891089108910892">
        </font>
      </scale_font>
      <visible>true</visible>
    </x_axis>
    <y_axes>
      <y_axis>
        <title>Voltage [V]</title>
        <autoscale>true</autoscale>
        <log_scale>false</log_scale>
        <minimum>-5.0E-12</minimum>
        <maximum>5.0E-12</maximum>
        <show_grid>true</show_grid>
        <title_font>
          <font name="IO Normal" family="sans" style="REGULAR" size="10.891089108910892">
          </font>
        </title_font>
        <scale_font>
          <font name="IO Scale 1" family="sans" style="REGULAR" size="10.891089108910892">
          </font>
        </scale_font>
        <on_right>false</on_right>
        <visible>true</visible>
        <color>
          <color name="Text" red="0" green="0" blue="0">
          </color>
        </color>
      </y_axis>
    </y_axes>
    <traces>
      <trace>
        <name>$(traces[0].y_pv)</name>
        <x_pv></x_pv>
        <y_pv>LEL:DIA:FCT01:AI0:AVG</y_pv>
        <err_pv></err_pv>
        <axis>0</axis>
        <trace_type>1</trace_type>
        <color>
          <color name="MAJOR" red="255" green="0" blue="0">
          </color>
        </color>
        <line_width>1</line_width>
        <line_style>0</line_style>
        <point_type>0</point_type>
        <point_size>4</point_size>
        <visible>true</visible>
      </trace>
    </traces>
    <marker>
      <marker>
        <color>
          <color name="Off" red="60" green="100" blue="60">
          </color>
        </color>
        <pv_name>loc://m1(800)</pv_name>
        <interactive>true</interactive>
      </marker>
      <marker>
        <color>
          <color name="OK" red="0" green="255" blue="0">
          </color>
        </color>
        <pv_name>loc://m2(1080)</pv_name>
        <interactive>true</interactive>
      </marker>
    </marker>
  </widget>
  <widget type="label" version="2.0.0">
    <name>Integral_Display_Target</name>
    <text>Channel 0 Integral Result local PV:</text>
    <x>385</x>
    <y>14</y>
    <width>200</width>
    <font>
      <font name="Default Bold" family="Liberation Sans" style="BOLD" size="14.0">
      </font>
    </font>
    <scripts>
      <script file="EmbeddedPy" check_connections="false">
        <text><![CDATA[from org.csstudio.display.builder.runtime.script import PVUtil
from jarray import array
import math  # Used for baseline noise standard deviation calculation

try:
    # --- INDEX 0: Raw waveform signal data array ---
    pv_reading = pvs[0].read() 
    
    if pv_reading is not None:
        raw_data = pv_reading.getData()
        
    if raw_data is not None and raw_data.size() > 50:
            total_samples = raw_data.size()
            attenuation_factor = 1.0 
            
            # --- INDEX 3: CLKF_SP (Sampling Rate Clock Speed) ---
            # No inner try/except block here. If reading fails or disconnects,
            # it directly hits your global exception handler to output "ERR".
            clk_val = PVUtil.getDouble(pvs[3])
            dt = 1.0 / (clk_val * 1e9)  
            # --- DETECT TIME STEP DYNAMICALLY ---
           #if clk_val < 100.0:
              #  dt = 1.0 / (clk_val * 1e9)  
            #else:
             #   dt = 1.0 / clk_val
            
            # --- DYNAMIC MEMORY TRUNCATION SAFETY ---
            valid_length = total_samples
            for i in range(total_samples - 2, 10, -1):
                if raw_data.getDouble(i) == raw_data.getDouble(i+1) == 0.0:
                    valid_length = i
                else:
                    break
            valid_length = max(100, min(valid_length, total_samples))

            # --- INDEX 1 & 2: Direct Absolute Local Markers ---
            m1_val = PVUtil.getDouble(pvs[1]) 
            m2_val = PVUtil.getDouble(pvs[2])   
            
            raw_m1, raw_m2 = m1_val, m2_val
            
            # Clamp markers strictly inside the working valid data window boundary
            start_index = max(0, min(int(round(m1_val)), valid_length - 2))
            stop_index = max(0, min(int(round(m2_val)), valid_length - 1))
            
            if start_index > stop_index:
                start_index, stop_index = stop_index, start_index
 
            # --- ANCHORED SAFE BASELINE (Indices 10 to 50) ---
            # Stays at the clean beginning of the array, safe from marker movements
            baseline_start = 10
            baseline_end = 50
                
            baseline_sum = 0.0
            for i in range(baseline_start, baseline_end):
                baseline_sum += raw_data.getDouble(i)
            baseline_avg = baseline_sum / float(baseline_end - baseline_start)
            
            # --- DIAGNOSTIC EXTRA: CALCULATE BASELINE NOISE ---
            variance_sum = 0.0
            for i in range(baseline_start, baseline_end):
                variance_sum += (raw_data.getDouble(i) - baseline_avg) ** 2
            baseline_rms_noise = math.sqrt(variance_sum / float(baseline_end - baseline_start))
            
            # --- DIAGNOSTIC EXTRA: WAVEFORM MINIMUM & GATED PEAK HEIGHT SEARCH ---
            min_val = 1e9
            min_idx = 0
            peak_corrected_volt = 0.0
            
            for i in range(valid_length):
                val = raw_data.getDouble(i)
                if val < min_val:
                    min_val = val
                    min_idx = i
                
                if i >= start_index and i <= stop_index:
                    dev = val - baseline_avg
                    if abs(dev) > abs(peak_corrected_volt):
                        peak_corrected_volt = dev
            
            # --- VISUAL ARRAY SNAPSHOT LOGGING ---
            print("\n--- RAW VOLTAGE SNAPSHOT (Every 20th Sample inside Gate) ---")
            step = max(1, (stop_index - start_index) // 20)
            for idx in range(start_index, stop_index, step):
                raw_val = raw_data.getDouble(idx)
                corrected_val = raw_val - baseline_avg
                print("Index {:4d} | Raw Volts: {:.6f} V | Baseline Corrected: {:.6f} V".format(idx, raw_val, corrected_val))
            print("------------------------------------------------------------")
            
            # --- FIXED SENSITIVITY CALIBRATION FACTOR ---
            S_FACTOR = 5.0
            
            # --- GATED AREA INTEGRATION LOOP ---
            charge_profile = [0.0] * total_samples
            running_area = 0.0
            final_frozen_charge = 0.0

            for idx in range(0, total_samples - 1):
                y1 = raw_data.getDouble(idx) - baseline_avg
                y2 = raw_data.getDouble(idx + 1) - baseline_avg
                
                if idx >= start_index and idx < stop_index:
                    running_area += (y1 + y2) / 2.0
                    
                v_secs = abs(running_area * dt)
                current_charge = (v_secs / S_FACTOR) * 1e12 * attenuation_factor
                charge_profile[idx] = current_charge
                
                if idx == stop_index - 1:
                    final_frozen_charge = current_charge
 
            charge_profile[-1] = charge_profile[-2]
            
            # --- NANOSECOND WINDOW CALCULATION ---
            window_width_samples = stop_index - start_index
            window_width_seconds = window_width_samples * dt
            window_width_ns = window_width_seconds * 1e9
            
            # --- METHOD B: TRIANGULAR CONVERSION WITH DYNAMIC BASE FINDING ---
            threshold = max(3.0 * baseline_rms_noise, 0.0015)  
            
            real_pulse_start = start_index
            real_pulse_stop = stop_index
            
            for i in range(start_index, stop_index):
                if abs(raw_data.getDouble(i) - baseline_avg) > threshold:
                    real_pulse_start = max(start_index, i - 1)
                    break
                    
            for i in range(stop_index, start_index, -1):
                if abs(raw_data.getDouble(i) - baseline_avg) > threshold:
                    real_pulse_stop = min(stop_index, i + 1)
                    break
            
            dynamic_width_seconds = (real_pulse_stop - real_pulse_start) * dt
            dynamic_width_ns = dynamic_width_seconds * 1e9
            
            v_secs_triangle = abs((dynamic_width_seconds * peak_corrected_volt) / 2.0)
            final_frozen_charge_tri = (v_secs_triangle / S_FACTOR) * 1e12 * attenuation_factor
            if math.isnan(final_frozen_charge_tri):
                final_frozen_charge_tri = 0.0

            # --- COMPREHENSIVE DEBUG CONSOLE LOGGING ---
            print("================== DIGITIZER DEBUG REPORT ==================")
            print("CH1 Array Total Size     : {} samples".format(total_samples))
            print("Clock Frequency PV       : {} GHz (dt = {:.3e} sec)".format(clk_val, dt))
            print("Fixed S-Factor Used      : {:.2f} V*s/C".format(S_FACTOR))
            print("UI Markers (Clamped/Used): Start = {}, Stop = {} (Width = {} samples)".format(start_index, stop_index, window_width_samples))
            print("UI Window Marker Span    : {:.3f} ns".format(window_width_ns))
            print("Detected Real Pulse Width: {:.3f} ns (Indices {} to {})".format(dynamic_width_ns, real_pulse_start, real_pulse_stop))
            print("------------------------------------------------------------")
            print("Baseline DC Offset level : {:.6f} V".format(baseline_avg))
            print("Gated Peak Dev from B/L  : {:.6f} V".format(peak_corrected_volt))
            print("------------------------------------------------------------")
            print("Calculated Target Charge : {:.4f} pC (Trap)".format(final_frozen_charge))
            print("Calculated Triangle Chg  : {:.4f} pC (Tri)".format(final_frozen_charge_tri))
            print("============================================================\n")
            
            # --- UPDATE THE TEXT READOUT LABEL WIDGET ---
            widget.setPropertyValue("text", "{:.2f} pC (Trapezoid integral)".format(final_frozen_charge))
            
            # --- PUSH VALUE TO SECONDARY TRIANGLE WIDGET VIA RECURSIVE LOOKUP ---
            try:
                triangle_label = None
                parent_opt = widget.getParent()
                
                if hasattr(parent_opt, "get"):
                    parent_obj = parent_opt.get() if parent_opt.isPresent() else None
                else:
                    parent_obj = parent_opt
                
                if parent_obj is not None:
                    if hasattr(parent_obj, "getChildByName"):
                        triangle_label = parent_obj.getChildByName("widget_triangle_label")
                    
                    if triangle_label is None and hasattr(parent_obj, "getChildren"):
                        for child in parent_obj.getChildren():
                            if hasattr(child, "getName") and child.getName() == "widget_triangle_label":
                                triangle_label = child
                                break
                                
                if triangle_label is None:
                    try:
                        display_model = widget.getDisplayModel()
                        for child in display_model.getChildren():
                            if hasattr(child, "getName") and child.getName() == "widget_triangle_label":
                                triangle_label = child
                                break
                    except Exception:
                        pass

                if triangle_label is not None:
                    triangle_label.setPropertyValue("text", "{:.2f} pC (Triangle Integral)".format(final_frozen_charge_tri))
            except Exception as widget_err:
                print("Failed updating secondary UI label: " + str(widget_err))
            
            # --- INDEX 4: WRITE TO THE WAVEFORM GRAPH ARRAY PV ---
            if len(pvs) > 4:
                try:
                    java_array = array(charge_profile, 'd')
                    pvs[4].write(java_array) 
                except Exception as plot_err:
                    print("Graph profile write failed: " + str(plot_err))
                         
except Exception as e:
    widget.setPropertyValue("text", "ERR: " + str(e))]]></text>
        <pv_name>LEL:DIA:FCT01:AI0:AVG</pv_name>
        <pv_name>loc://m1</pv_name>
        <pv_name>loc://m2</pv_name>
        <pv_name trigger="false">LEL:DIA:FCT01:CLKF_SP</pv_name>
        <pv_name trigger="false">loc://fct01_integral_out[2048](0.0)</pv_name>
        <pv_name trigger="false">LEL:DIA:FCT01:CHARGE_FINAL</pv_name>
        <pv_name trigger="false">LEL:DIA:FCT01:AI0:ATT_RB</pv_name>
        <pv_name trigger="false">LEL:DIA:FCT01:AI0:TCNT</pv_name>
        <pv_name trigger="false">LEL:DIA:FCT01:AI0:OFS_SP</pv_name>
        <pv_name trigger="false">LEL:DIA:FCT01:AI0:RNG_RB</pv_name>
      </script>
    </scripts>
  </widget>
