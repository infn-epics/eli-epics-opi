      <tab>
        <name>Camera</name>
        <children>
          <widget type="action_button" version="3.0.0">
            <name>cameraInterfaceBase</name>
            <actions>
              <action type="open_display">
                <file>common/camera/Camera.bob</file>
                <macros>
                  <DEVICE>LEL</DEVICE>
                  <CAM></CAM>
                  <CONFFILE>cam_list.ini</CONFFILE>
                </macros>
                <target>window</target>
                <description>Camera APP</description>
              </action>
            </actions>
            <text>CAMERA APP</text>
            <x>52</x>
            <y>368</y>
            <width>160</width>
            <height>110</height>
            <visible>false</visible>
            <tooltip>$(actions)</tooltip>
          </widget>
          <widget type="action_button" version="3.0.0">
            <name>cameraInterfaceBase_1</name>
            <actions>
              <action type="open_display">
                <file>epik8s-opi/screen-camera-opi/CameraFull.bob</file>
                <macros>
                  <DEVICE>LEL</DEVICE>
                  <CONFFILE>../../../deploy/values.yaml</CONFFILE>
                </macros>
                <target>window</target>
                <description>Camera Scren APP</description>
              </action>
            </actions>
            <text>CAMERA Screen</text>
            <x>52</x>
            <y>58</y>
            <width>190</width>
            <height>130</height>
            <tooltip>$(actions)</tooltip>
          </widget>
          <widget type="group" version="3.0.0">
            <name>Light</name>
            <x>122</x>
            <y>298</y>
            <width>220</width>
            <height>120</height>
            <widget type="bool_button" version="2.0.0">
              <name>Boolean Button</name>
              <pv_name>LEL:ILLUM:ICPDAS:CAMILLUM:RLY_SP</pv_name>
              <x>72</x>
              <y>12</y>
              <height>50</height>
            </widget>
            <widget type="led" version="2.0.0">
              <name>LED</name>
              <pv_name>LEL:ILLUM:ICPDAS:CAMILLUM:RLY_RB</pv_name>
              <x>12</x>
              <y>12</y>
              <width>50</width>
              <height>50</height>
            </widget>
          </widget>
          <widget type="action_button" version="3.0.0">
            <name>cameraInterfaceBase_2</name>
            <actions>
              <action type="open_display">
                <file>epik8s-opi/unicam-opi-v2/CameraV2.bob</file>
                <macros>
                  <DEVICE>LEL</DEVICE>
                  <CONFFILE>../../../deploy/values.yaml</CONFFILE>
                </macros>
                <target>window</target>
                <description>Camera2 Screen APP</description>
              </action>
            </actions>
            <text>CAMERA2 Screen</text>
            <x>342</x>
            <y>58</y>
            <width>190</width>
            <height>130</height>
            <tooltip>$(actions)</tooltip>
          </widget>
        </children>
