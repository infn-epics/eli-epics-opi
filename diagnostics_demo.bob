      <tab>
        <name>Orbit</name>
        <children>
          <widget type="action_button" version="3.0.0">
            <name>Action Button_OpenOrbitSingle</name>
            <actions>
              <action type="open_display">
                <file>epik8s-opi/unibpm-opi/orbitSingle.bob</file>
                <macros>
                  <P>$(P=LEL:ORBIT)</P>
                </macros>
                <target>window</target>
